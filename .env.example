# 本地开发环境配置模板。复制为 .env 后按需修改。
# 生产环境通过 K8s ConfigMap / Secret / Vault 注入,不要 commit .env 文件。

# ====== MySQL ======
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=ragdoc

# ====== MinIO ======
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=ragdoc

# ====== 应用层 ======
LLM_API_KEY=sk-change-me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen2.5-7b-instruct

# Phase 1.B LLM Gateway fallback route (可选):
# 不配或留空 → LlmRouter 仅用 primary(等价 baseline 行为)。
# 配上 → primary GLM-4-plus 500/timeout/熔断时自动切到此 route。
# 推荐选异族(LLM_API_KEY 与本 fallback 不同家族)避免同源服务 collectively fail。
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-chat

# V1 鉴权: dev token,生产换 JWT
APP_DEV_TOKEN=dev-token-change-me
APP_ADMIN_TOKEN=admin-token-change-me

# ====== Phase 0.1: 评测 Judge LLM(与业务 LLM 物理隔离, 防 RAGAS 同源污染) ======
# 业务 LLM 走 LLM_BASE_URL/LLM_API_KEY/LLM_MODEL (上面); RAGAS judge 必须异族异源。
# 评测脚本 (eval/ragas_pipeline.py / judge_client.py) 只读下面, 绝不 fallback 到 LLM_*。
#
# 业务 LLM 是 GLM (智谱) → judge 必须 NOT GLM。Phase 0 选 DeepSeek-V3 作为 provider 1。
# provider 1 = DeepSeek-V3(异族)  — Step 3 STOP 校验 + 单 judge 默认
JUDGE_LLM_PROVIDER_1_BASE_URL=https://api.deepseek.com/v1
JUDGE_LLM_PROVIDER_1_API_KEY=your-deepseek-api-key-here
JUDGE_LLM_PROVIDER_1_MODEL=deepseek-chat
# provider 2 = Qwen-Max / Claude / GPT-4o (任一, 用于 Phase 0.3 ensemble majority vote)
# 也必须异族 — 不要也用 GLM 或 DeepSeek, 否则 ensemble 退化成单一判官。
# JUDGE_LLM_PROVIDER_2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# JUDGE_LLM_PROVIDER_2_API_KEY=your-qwen-key
# JUDGE_LLM_PROVIDER_2_MODEL=qwen-max
# 多 provider 扩展: JUDGE_LLM_PROVIDER_3_* 按 id 顺序继续加, judge_client 自动 discover。

# ====== Docker compose bind mount: BGE 模型 cache 路径 ======
# OPS-V3-B: 从 deploy/docker-compose.yml 抽出来。默认值是 mac dev 机路径,
# 其它机器覆盖这俩变量即可 (Linux: /opt/models/bge-m3-cache 之类)。
# BGE-M3 模型按 HF hub cache 标准结构 (models--BAAI--bge-m3/refs/main, snapshots/<commit>/*.bin).
BGE_M3_CACHE_DIR=/Users/huanqi/RagDoc/testdata/bge-m3-cache
# BGE-Reranker-v2-m3 13 个文件平铺目录 (含 model.safetensors + tokenizer*.json + onnx/).
BGE_RERANKER_DIR=/Users/huanqi/RagDoc/testdata/bge-reranker-v2-m3
