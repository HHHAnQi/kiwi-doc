  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "1. Chat First-Token Latency (p50 / p95 / p99)",
      "description": "ADR-0004 L1 SLA: p95 ≤ 2s. SSE 首 token 延迟。",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ragdoc_chat_first_token_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ragdoc_chat_first_token_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ragdoc_chat_first_token_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "2. Chat Total Latency (by outcome, p95)",
      "description": "ADR-0004 L1 SLA: p95 ≤ 15s. outcome tag: ok / degraded / skipped (EMPTY_KB 或 NO_RECALL)。",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ragdoc_chat_total_latency_seconds_bucket{outcome=\"ok\"}[5m])) by (le))",
          "legendFormat": "ok p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ragdoc_chat_total_latency_seconds_bucket{outcome=\"degraded\"}[5m])) by (le))",
          "legendFormat": "degraded p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ragdoc_chat_total_latency_seconds_bucket{outcome=\"skipped\"}[5m])) by (le))",
          "legendFormat": "skipped p95",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "3. Retrieve Recall Count 分布",
      "description": "每次 retrieve 最终喂 LLM 的 chunk 数。0 = NO_RECALL 比例高 = 检索召回质量问题。",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, ragdoc_retrieve_recall_count[5m])",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "quantile_over_time(0.10, ragdoc_retrieve_recall_count[5m])",
          "legendFormat": "p10 ( 低召回尾巴 )",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "4. Rerank Latency + 失败比例",
      "description": "rerank disabled 时此图为空。outcome=failed 高 = TEI reranker 不稳, RetrieveService 会降级走 hybrid seq。",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ragdoc_rerank_latency_seconds_bucket{outcome=\"ok\"}[5m])) by (le))",
          "legendFormat": "rerank ok p95",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ragdoc_rerank_latency_seconds_count{outcome=\"failed\"}[5m]))",
          "legendFormat": "rerank failed rate/s",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "5. LLM Call Outcome (rate by tag)",
      "description": "outcome=ok 单调升 = 成功 ; outcome=degraded / attempted 比例上升 = LLM/网关稳定性下降。",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(ragdoc_llm_call_total_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "6. P3-5 LLM Token Rate (5m, by type & model)",
      "description": "RagdocMetrics.recordTokens() 上报。同步 /chat 路径有效; SSE /chat/sse 暂未上报 (Phase 3 / P3-5 决策)。tags: type=prompt|completion, route=llm-primary, model=glm-4-plus|deepseek-chat…",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(ragdoc_llm_token_total_total[5m])) by (type, model)",
          "legendFormat": "{{type}} / {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "title": "7. P3-5 Approx Daily Cost (¥, by model)",
      "description": "近 24h 累计 token × 单价估算 (best-effort)。模型单价需按上线时 Zhipu/DeepSeek 官网公告调整 — 默认值: glm-4-plus ¥0.05/1K (in & out 一档), deepseek-chat ¥0.001/1K in + ¥0.002/1K out, qwen-max ¥0.04/1K。",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "currencyCNY" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(increase(ragdoc_llm_token_total_total{model=\"glm-4-plus\", type=\"prompt\"}[24h])) + sum(increase(ragdoc_llm_token_total_total{model=\"glm-4-plus\", type=\"completion\"}[24h]))) * 0.05 / 1000",
          "legendFormat": "glm-4-plus (¥0.05/1K)",
          "refId": "A"
        },
        {
          "expr": "(sum(increase(ragdoc_llm_token_total_total{model=\"deepseek-chat\", type=\"prompt\"}[24h])) * 0.001 + sum(increase(ragdoc_llm_token_total_total{model=\"deepseek-chat\", type=\"completion\"}[24h])) * 0.002) / 1000",
          "legendFormat": "deepseek-chat (¥0.001/0.002 per 1K)",
          "refId": "B"
        },
        {
          "expr": "((sum(increase(ragdoc_llm_token_total_total{model!=\"glm-4-plus\", model!=\"deepseek-chat\", type=\"prompt\"}[24h])) + sum(increase(ragdoc_llm_token_total_total{model!=\"glm-4-plus\", model!=\"deepseek-chat\", type=\"completion\"}[24h]))) * 0.04) / 1000",
          "legendFormat": "其他 (¥0.04/1K, qwen-max 占位)",
          "refId": "C"
        }
      ]
    }
  ],
